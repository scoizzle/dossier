{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dossier.local/contract/ops.schema.json",
  "title": "Dossier operations",
  "description": "Request/response shapes for dump, post_facts, correlate, search, compile_dossier, verify_facts, changes. Core is pure functions over a Store; transports call the same functions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dump": { "$ref": "#/$defs/Op_dump" },
    "post_facts": { "$ref": "#/$defs/Op_post_facts" },
    "correlate": { "$ref": "#/$defs/Op_correlate" },
    "search": { "$ref": "#/$defs/Op_search" },
    "compile_dossier": { "$ref": "#/$defs/Op_compile_dossier" },
    "verify_facts": { "$ref": "#/$defs/Op_verify_facts" },
    "changes": { "$ref": "#/$defs/Op_changes" }
  },
  "$defs": {
    "Op_dump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/DumpRequest" },
        "response": { "$ref": "#/$defs/DumpResponse" }
      }
    },
    "Op_post_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/PostFactsRequest" },
        "response": { "$ref": "#/$defs/PostFactsResponse" }
      }
    },
    "Op_correlate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/CorrelateRequest" },
        "response": { "$ref": "#/$defs/CorrelateResponse" }
      }
    },
    "Op_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/SearchRequest" },
        "response": { "$ref": "#/$defs/SearchResponse" }
      }
    },
    "Op_compile_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/CompileRequest" },
        "response": { "$ref": "dossier.schema.json" }
      }
    },

    "Op_verify_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/VerifyRequest" },
        "response": { "$ref": "#/$defs/VerifyResponse" }
      }
    },
    "Op_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/ChangesRequest" },
        "response": { "$ref": "#/$defs/ChangesPage" }
      }
    },

    "DumpRequest": {
      "title": "dump request",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "subject"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "split": { "type": "string", "enum": ["heading", "file", "none"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DumpResponse": {
      "title": "dump response",
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "deduped", "skipped", "errors"],
      "properties": {
        "created": { "type": "array", "items": { "type": "string" }, "description": "Fact ids." },
        "deduped": { "type": "array", "items": { "type": "string" }, "description": "Existing fact ids." },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "reason"],
            "properties": {
              "locator": { "$ref": "ref.schema.json#/$defs/Locator" },
              "reason": { "type": "string" }
            }
          }
        },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },

    "SubjectInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "parent": { "type": "string", "minLength": 1 },
            "aliases": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "FactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "local_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "data": { "description": "Any JSON value." },
        "items": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/Item" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "refs": { "type": "array", "items": { "$ref": "ref.schema.json" } },
        "attachments": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/Attachment" } }
      }
    },
    "PostFactsRequest": {
      "title": "post_facts request",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "facts"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/SubjectInput" },
        "redact": { "type": "array", "items": { "type": "string" } },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/FactInput" } }
      }
    },
    "PostFactsResponse": {
      "title": "post_facts response",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "facts"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "created"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "created": { "type": "boolean" },
            "parent": { "type": "string", "minLength": 1 }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["new", "deduped", "replaced", "near_duplicate"] },
              "replaced": { "type": "string", "description": "Id of the fact replaced (status=replaced)." },
              "duplicate_of": { "type": "string", "description": "Id of the existing fact (deduped / near_duplicate)." },
              "superseded": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "description": "Ids of facts this post superseded through a supersedes ref, whatever the status. Absent when no ref took effect."
              }
            }
          }
        }
      }
    },

    "CorrelateRequest": {
      "title": "correlate request",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "matchers": { "type": "array", "items": { "type": "string", "enum": ["same_ref", "shared_tag"] } }
      }
    },
    "CorrelateResponse": {
      "title": "correlate response",
      "description": "Deterministic matchers only. Proposed refs carry basis \"derived\" and are never asserted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed"],
      "properties": {
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_id", "ref"],
            "properties": {
              "fact_id": { "type": "string", "minLength": 1, "description": "Fact that would carry the ref." },
              "ref": {
                "allOf": [
                  { "$ref": "ref.schema.json" },
                  { "properties": { "basis": { "const": "derived" } } }
                ]
              }
            }
          }
        }
      }
    },

    "SearchRequest": {
      "title": "search request",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "status": { "$ref": "fact.schema.json#/$defs/Status", "description": "Filters by derived status: live excludes a stored-live fact that is stale or contested, and stale or contested returns exactly those. Without it, superseded and retracted facts are left out and everything else is returned." },
        "since": { "type": "string", "format": "date-time" },
        "q": { "type": "string" },
        "ref_target": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "limit": { "type": "integer", "minimum": 1, "default": 20 },
        "cursor": { "type": "string" },
        "brief": { "type": "boolean", "description": "One short line per hit (id, kind, status, the first 120 characters of text) in place of full FactViews." }
      }
    },
    "SearchResponse": {
      "title": "search response",
      "type": "object",
      "additionalProperties": false,
      "required": ["hits", "total", "complete"],
      "properties": {
        "hits": { "type": "array", "items": { "$ref": "dossier.schema.json#/$defs/FactView" } },
        "total": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "refine": { "type": "string" },
        "next": { "type": "string" }
      }
    },

    "CompileRequest": {
      "title": "compile_dossier request",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "descendants": { "type": "boolean" },
        "needs": { "type": "array", "items": { "type": "string" } },
        "budget": { "type": "integer", "minimum": 0, "description": "Complete mode: the highlight threshold. Strict mode: a hard cutoff." },
        "budget_mode": { "type": "string", "enum": ["complete", "strict"], "default": "complete", "description": "complete emits every fact; strict cuts to the budget and lists the rest in dropped." },
        "depth": { "type": "string", "enum": ["index", "full"] },
        "order": { "type": "string", "enum": ["rank", "seq"] },
        "rank": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recency": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "follow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rels": { "type": "array", "items": { "type": "string" } },
            "hops": { "type": "integer", "enum": [1, 2] }
          }
        },
        "format": { "type": "string", "enum": ["json", "markdown"] }
      }
    },

    "VerifyRequest": {
      "title": "verify_facts request",
      "description": "The fact ids a plan, summary or answer cites. Repeated ids are answered once.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 200 }
      }
    },
    "VerifyResponse": {
      "title": "verify_facts response",
      "description": "Derived status of each requested fact, read in one snapshot; nothing is written. current is true only when every fact is live.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "current", "facts"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "description": "The store revision the answer was read at." },
        "current": { "type": "boolean" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/VerifiedFact" }, "description": "One entry per distinct requested id, in request order." }
      }
    },
    "VerifiedFact": {
      "title": "VerifiedFact",
      "description": "status precedence: retracted, superseded (both stored), then stale, then contested, else live. unknown is an id the store does not hold. stale: a live fact with a derived_from ref of kind fact to a fact that was retracted, was superseded by a different claim (a different content_hash), or is itself stale. contested: a live, non-stale fact that a live, non-stale fact refutes or contradicts (ref of kind fact), or that itself contradicts one. Slot refs and external refs never make a fact stale or contested.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "current"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1, "description": "Absent when status is unknown." },
        "status": { "type": "string", "enum": ["live", "superseded", "retracted", "stale", "contested", "unknown"] },
        "current": { "type": "boolean", "description": "True only when status is live." },
        "replaced_by": { "type": "string", "minLength": 1, "description": "status=superseded only: the live fact at the end of its chain of successors (keyed reposts and corrections by supersedes ref), which may be several steps later. Absent when the chain ends in a retraction." },
        "why": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StatusReason" }, "description": "status=stale or contested only." }
      }
    },
    "StatusReason": {
      "title": "StatusReason",
      "description": "rel=derived_from: fact is an input that changed, state says how, and replaced_by names the fact that replaced a superseded input. rel=refutes|contradicts: fact is the other party of the dispute.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "fact"],
      "properties": {
        "rel": { "type": "string", "enum": ["derived_from", "refutes", "contradicts"] },
        "fact": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["superseded", "retracted", "stale"], "description": "rel=derived_from only." },
        "replaced_by": { "type": "string", "minLength": 1, "description": "rel=derived_from with state=superseded only." }
      }
    },

    "ChangesRequest": {
      "title": "changes request",
      "description": "Rows written after since (default 0), oldest first, at most limit; or the newest last rows when last is given (it wins). subject (id, name or alias) keeps one subject's rows; an unknown subject is rejected with subject_not_found.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "since": { "type": "integer", "minimum": 0 },
        "last": { "type": "integer", "minimum": 1, "description": "At most 500; a larger value is clamped." },
        "limit": { "type": "integer", "minimum": 1, "default": 100, "description": "At most 500; a larger value is clamped." },
        "subject": { "type": "string", "minLength": 1 }
      }
    },
    "ChangesPage": {
      "title": "changes response",
      "description": "A page of the change journal. Pass next back as since. reset true means the cursor is ahead of the head or behind the retained window: re-read everything. The journal records row writes only, so a fact that became stale or contested through another fact's write has no row of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "next", "truncated", "reset", "changes"],
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "next": { "type": "integer", "minimum": 0, "description": "With a subject filter and truncated false this is the head, so the cursor skips other subjects' rows." },
        "truncated": { "type": "boolean", "description": "More matching rows exist past next (since), or before the page (last)." },
        "reset": { "type": "boolean" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/ChangeRow" } }
      }
    },
    "ChangeRow": {
      "title": "ChangeRow",
      "description": "One row write to facts, subjects, refs or slots. The fact fields describe the fact as it is now, not as it was at seq.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "tbl", "op", "subject_id", "subject_name", "fact_id", "fact_kind", "fact_status", "text", "actor", "at"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1, "description": "The revision the write committed under." },
        "tbl": { "type": "string", "enum": ["facts", "subjects", "refs", "slots"] },
        "op": { "type": "string", "enum": ["insert", "update", "delete"] },
        "subject_id": { "type": ["string", "null"] },
        "subject_name": { "type": ["string", "null"] },
        "fact_id": { "type": ["string", "null"] },
        "fact_kind": { "type": ["string", "null"] },
        "fact_status": { "type": ["string", "null"], "description": "Stored status: live, superseded or retracted." },
        "text": { "type": ["string", "null"], "description": "Fact text cut to 160 characters. Untrusted data." },
        "actor": { "type": ["string", "null"], "description": "Set only on a fact insert: that fact's provenance actor, an unauthenticated label." },
        "at": { "type": "string", "description": "ISO 8601 UTC." }
      }
    }
  }
}
