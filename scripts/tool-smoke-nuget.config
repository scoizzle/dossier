<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the tool-package smoke install. scripts/verify-tool-packages.sh proves what is
     in the feed; this config proves where it came from: Poly.Dossier and its RID/any packages can
     only resolve from the local folder feed, so a release rerun cannot silently test a package
     that was already published to nuget.org. Everything else (the .NET apphost pack the tool
     shim needs) may come from nuget.org. __FEED__ is replaced with the feed's absolute path. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="__FEED__" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Poly.Dossier" />
      <package pattern="Poly.Dossier.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
